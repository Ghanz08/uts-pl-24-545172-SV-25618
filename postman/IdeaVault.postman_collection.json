{
  "info": {
    "name": "IdeaVault API (UTS PL)",
    "description": "RESTful API IdeaVault - Laravel 12 + Sanctum, dilayani FrankenPHP.\n\nJalankan **Auth → Login** dulu; token otomatis disimpan ke variabel `token`. **Create idea** menyimpan `idea_id` untuk request berikutnya.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "idea_id",
      "value": ""
    },
    {
      "key": "email",
      "value": "demo@ideavault.test"
    },
    {
      "key": "password",
      "value": "password123"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response is JSON\", () => pm.response.to.be.json);",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Satu-satunya endpoint publik. Mengembalikan Bearer token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login - wrong password (422)",
          "event": [
            {
              "listen": "test",
              "script": {
