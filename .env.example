# Copy to .env and fill in real values. .env is git-ignored and must never be committed.
#   cp .env.example .env
#   Generate APP_KEY:  echo "base64:$(openssl rand -base64 32)"

APP_KEY=

DB_DATABASE=ideavault
DB_USERNAME=ideavault
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Demo account created by the seeder on first start.
DEMO_USER_EMAIL=demo@ideavault.test
DEMO_USER_PASSWORD=password123

FRONTEND_PORT=8080
BACKEND_PORT=8000
